# Copy to .env (never commit it). All optional in development.
ANTHROPIC_API_KEY=        # turns on the AI tutor
TUTOR_MODEL=claude-sonnet-5-5   # or claude-opus-5-5 (costs more per answer)
TUTOR_DAILY_CAP=40        # questions per student, per course, per day
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
BRAND_NAME=Ironwood Tech
BRAND_CONTACT_EMAIL=hello@example.com
APP_TIME_ZONE="Central Time (US & Canada)"
ALLOW_INDEXING=0

# Selling courses (Stripe Checkout). Leave empty and the Buy button is switched
# off with a message; nothing breaks. Use TEST keys first (sk_test_...).
# Never commit real values: put them in .env or the server's secrets.
STRIPE_SECRET_KEY=        # sk_test_... from the Stripe dashboard, Developers > API keys (test mode)
STRIPE_WEBHOOK_SECRET=    # whsec_... from `stripe listen` or the dashboard webhook for /webhooks/stripe
STRIPE_TAX=               # 1 only after Stripe Tax is turned on in the Stripe dashboard
STRIPE_TEST_IN_PRODUCTION=  # 1 lets a TEST key work on the real site (anyone could then "buy" with a test card)
# Seller identity. Real-money checkout (a live key, or any key in production)
# stays blocked until all of these are set and the contact email is a real one.
BRAND_LEGAL_NAME=
BRAND_POSTAL_ADDRESS=
# The day the policies go live, as it should read on the page (November 24, 2026).
POLICY_PUBLISH_DATE=
# Hosting only (set in fly.toml, leave unset on the Mac):
# FORCE_SSL=1             # HTTPS ends in front of the app
# APP_HOST=learn.example.org
