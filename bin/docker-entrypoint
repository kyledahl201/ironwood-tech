#!/bin/bash -e

# Use jemalloc to reduce memory use.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Prepare the database (and seed courses and exercises) when starting the server.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  # Old tutor chats are also deleted here, because the 4 AM job (config/recurring.yml)
  # can't run on a host that stops the server while nobody is using it (fly.toml).
  ./bin/rails db:seed tutor:purge_expired
fi

exec "${@}"
