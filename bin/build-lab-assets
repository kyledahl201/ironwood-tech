#!/usr/bin/env bash
# Rebuilds the bundled editor and the Ruby, Python, JavaScript and SQL workers from
# vendor/lab-src, and fetches the checksummed Ruby, Python and SQLite runtimes.
set -euo pipefail
cd "$(dirname "$0")/../vendor/lab-src"
npm install --no-audit --no-fund --silent
npx esbuild editor.js --bundle --format=esm --minify --legal-comments=none --outfile=../../app/javascript/lab/editor.js
npx esbuild ruby-worker.js --bundle --format=esm --minify --legal-comments=none --outfile=../../public/lab/ruby-worker.js
npx esbuild python-worker.js --bundle --format=esm --minify --legal-comments=none --outfile=../../public/lab/python-worker.js
npx esbuild js-worker.js --bundle --format=esm --minify --legal-comments=none --outfile=../../public/lab/js-worker.js
npx esbuild sql-worker.js --bundle --format=esm --minify --legal-comments=none --external:fs --external:path --external:crypto --outfile=../../public/lab/sql-worker.js
../../bin/fetch-ruby-wasm
../../bin/fetch-pyodide
../../bin/fetch-sqlite
echo "Built app/javascript/lab/editor.js and the workers in public/lab; runtimes are in public/lab"
