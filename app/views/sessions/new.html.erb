<% page_title "Log in" %>
<div class="auth">
  <p class="eyebrow">Students</p>
  <h1>Log in</h1>
  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="field"><%= form.label :email_address, "Email" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></div>
    <div class="field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></div>
    <div><%= form.submit "Log in", class: "btn btn-primary" %></div>
  <% end %>
  <p style="margin-top:24px"><%= link_to "Forgot your password?", new_password_path %> · New here? <%= link_to "Create an account", new_registration_path %></p>
</div>
