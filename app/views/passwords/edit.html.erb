<% page_title "Choose a new password" %>
<div class="auth">
  <h1>Choose a new password</h1>
  <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
    <div class="field"><%= form.label :password, "New password" %><span class="hint">At least 10 characters.</span><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <div class="field"><%= form.label :password_confirmation, "Repeat it" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <div><%= form.submit "Save", class: "btn btn-primary" %></div>
  <% end %>
</div>
