<% page_title "Reset your password" %>
<div class="auth">
  <h1>Forgot your password?</h1>
  <p>Enter your email and we'll send reset instructions.</p>
  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field"><%= form.label :email_address, "Email" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></div>
    <div><%= form.submit "Email reset instructions", class: "btn btn-primary" %></div>
  <% end %>
</div>
