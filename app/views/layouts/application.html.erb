<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description).presence || "Hands-on courses in AI workflows and agentic AI, taught one step at a time by AI tutors." %>">
    <% unless brand.indexable %><meta name="robots" content="noindex, nofollow"><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <% unless brand.indexable %>
      <div class="project-strip" role="note">
        <div class="wrap">Pre-launch preview. <%= brand.disclosure_short %> <%= link_to "What that means", about_path(anchor: "honest") %></div>
      </div>
    <% end %>
    <% if current_user&.admin? %>
      <div class="admin-bar no-print"><div class="wrap"><strong>Owner:</strong> <%= link_to "Dashboard", admin_root_path %><%= link_to "Leads", admin_leads_path %><%= link_to "Students", admin_users_path %><%= link_to "Courses", admin_courses_path %></div></div>
    <% end %>
    <%= render "shared/header" %>
    <% flash.each do |type, message| %>
      <div class="flash flash-<%= type == "alert" ? "alert" : "notice" %>" role="status"><div class="wrap"><%= message %></div></div>
    <% end %>
    <main id="main">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
