<% page_title @tool.title %>
<header class="page-head lab-head"><div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><%= link_to "Visualizers", visualizers_path %></li><li aria-current="page"><%= @tool.title %></li></ol></nav>
  <p class="eyebrow"><%= @tool.eyebrow %></p><h1><%= @tool.title %></h1>
  <p class="lede"><%= @tool.blurb %> Predict the next line before you press Step.</p></div></header>
<section class="section"><div class="wrap">
  <%= render "visualizers/tracer", tool: @tool %>
  <nav class="lab-siblings" aria-label="Other visualizers">
    <% @tools.each do |t| %><%= link_to t.title, visualizer_path(t.id), class: ("is-current" if t == @tool), "aria-current": (t == @tool ? "page" : nil) %><% end %>
  </nav>
</div></section>
