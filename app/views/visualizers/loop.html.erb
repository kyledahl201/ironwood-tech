<% page_title "Loop tracer" %>
<header class="page-head lab-head"><div class="wrap"><p class="eyebrow">Visualizers</p><h1>Loop tracer</h1>
  <p class="lede">Watch Ruby walk through <code>.each</code> one line at a time. Change the words or the limit, then step through again. Predict the next line before you press Step.</p></div></header>
<section class="section"><div class="wrap">
  <div class="tracer" data-controller="tracer">
    <form class="tracer-inputs" data-action="submit->tracer#rebuild change->tracer#rebuild">
      <label>Words <input type="text" data-tracer-target="words" value="oak, copper, owl, midnight" maxlength="80" spellcheck="false"></label>
      <label>Longer than <input type="number" data-tracer-target="limit" value="3" min="0" max="20"> letters</label>
    </form>
    <div class="tracer-grid">
      <div class="tracer-code" aria-label="Program">
        <ol class="code-lines" data-tracer-target="code"></ol>
      </div>
      <div class="tracer-state">
        <h2 class="lab-sub">The array</h2>
        <ol class="array-boxes" data-tracer-target="array" aria-label="The words array"></ol>
        <h2 class="lab-sub">Variables</h2>
        <dl class="vars" data-tracer-target="vars"></dl>
        <h2 class="lab-sub">Output</h2>
        <pre class="console-body small-console" data-tracer-target="output"></pre>
      </div>
    </div>
    <p class="tracer-note" data-tracer-target="note" aria-live="polite"></p>
    <div class="tracer-controls">
      <button type="button" class="btn btn-outline" data-action="tracer#back" data-tracer-target="backButton">◀ Back</button>
      <button type="button" class="btn btn-copper" data-action="tracer#step" data-tracer-target="stepButton">Step ▶</button>
      <button type="button" class="btn btn-outline" data-action="tracer#play" data-tracer-target="playButton">Play</button>
      <button type="button" class="link-button" data-action="tracer#reset">Start over</button>
      <span class="small muted" data-tracer-target="counter"></span>
    </div>
  </div>
</div></section>
