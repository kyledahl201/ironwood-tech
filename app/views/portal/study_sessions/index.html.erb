<% page_title "Study log" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Portal</p><h1>Study log</h1><p class="lede">Every session you log feeds the heatmap, the streak and the hours on your tree.</p></div></header>
<section class="section"><div class="wrap split">
  <div>
    <h2>Log a session</h2>
    <%= form_with model: @session, url: portal_study_sessions_path, class: "form" do |f| %>
      <div class="field"><%= f.label :studied_on, "Date" %><%= f.date_field :studied_on, max: Time.zone.today %></div>
      <div class="field"><%= f.label :minutes %><%= f.number_field :minutes, min: 5, max: 960, step: 5 %></div>
      <div class="field"><%= f.label :course_code, "Course (optional)" %><%= f.select :course_code, @codes, include_blank: true %></div>
      <div class="field"><%= f.label :note, "Note (optional)" %><%= f.text_field :note, maxlength: 200 %></div>
      <div><%= f.submit "Log it", class: "btn btn-primary" %></div>
    <% end %>
  </div>
  <div>
    <h2>Recent sessions</h2>
    <% if @sessions.any? %>
      <div class="table-scroll"><table>
        <thead><tr><th>Date</th><th>Time</th><th>Course</th><th>Note</th><th></th></tr></thead>
        <tbody><% @sessions.each do |s| %>
          <tr><td><%= s.studied_on.to_fs(:short) %></td><td><%= s.minutes %> min</td><td><%= s.course_code %></td><td><%= s.note %></td>
          <td><%= button_to "Remove", portal_study_session_path(s), method: :delete, class: "link-button small", form: { data: { turbo_confirm: "Remove this session?" } } %></td></tr>
        <% end %></tbody>
      </table></div>
    <% else %><p class="muted">Your first session starts the heatmap.</p><% end %>
  </div>
</div></section>
