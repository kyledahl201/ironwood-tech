<% page_title "Classroom" %>
<div data-controller="course-dialog">
  <header class="page-head lab-head"><div class="wrap">
    <p class="eyebrow">Classroom</p>
    <% if @begun %>
      <h1><%= @current ? "Pick a class" : "You're caught up, #{current_user.first_name}" %></h1>
      <p class="lede"><%= @current ? "You're in a class right now. Carry on with it, or open a different course." : "Every class open to you is finished. Open a course to go through a class again, or start a new one." %></p>
    <% else %>
      <h1>Welcome to the classroom, <%= current_user.first_name %></h1>
      <p class="lede">Class happens right here. Your professor teaches one step at a time, and you do the work in the workbench underneath. Nothing you type here touches your Mac.</p>
    <% end %>
  </div></header>
  <section class="section"><div class="wrap welcome">
    <% if @recommended %>
      <% entry = @entries.find { |e| e.code == @recommended.course_code } %>
      <article class="welcome-first">
        <p class="eyebrow"><%= @current ? "Your class" : (@begun ? "A good next class" : "A good first class") %></p>
        <h2><%= @recommended.title %></h2>
        <p><%= @recommended.tour? ? "A short tour with Sentry, the school's lookout. You'll run a few commands in the practice Terminal and see how steps, checks and hints work." : entry&.tagline %></p>
        <p class="meta"><%= [ (@recommended.tour? ? nil : "#{entry&.program} · #{@recommended.course_code} · Lesson #{@recommended.lesson_number}"), (@recommended.professor && "#{@recommended.professor} (AI tutor)"), (@recommended.minutes && "about #{@recommended.minutes} minutes"), "#{@recommended.steps.size} steps" ].compact.join(" · ") %></p>
        <p class="actions">
          <%= link_to (@current ? "Resume class" : "Start this class"), class_lesson_path(@recommended), class: "btn btn-copper btn-lg" %>
          <%= link_to "Show full course list", courses_path, class: "btn btn-outline btn-lg", data: { action: "course-dialog#open" }, aria: { haspopup: "dialog" } %>
        </p>
      </article>
    <% else %>
      <p class="actions"><%= link_to "Show full course list", courses_path, class: "btn btn-copper btn-lg", data: { action: "course-dialog#open" }, aria: { haspopup: "dialog" } %></p>
    <% end %>
    <% if @begun %>
      <h2 class="welcome-list-head">All courses</h2>
      <%= render "courses/list", entries: @entries, current_code: @current&.course_code, prefix: "page", heading: 3 %>
    <% end %>
    <p class="small muted" style="margin-top:24px">Checks in the classroom run in your browser, so they are self-checked practice. Your professors give the grades. Professors here are AI tutor personas, not people.</p>
  </div></section>
  <%= render "courses/dialog", entries: @entries, current_code: @current&.course_code %>
</div>
