<% page_title "Join" %>
<div class="auth">
  <p class="eyebrow"><%= @invite ? "You're invited" : "Step 1 of 2" %></p>
  <h1>Create your account</h1>
  <% unless @invite %><p>This account is where <strong><%= @course.title %></strong> will live. Next you'll pay <%= @course.price %> on Stripe's secure page. Already have an account? <%= link_to "Sign in", new_session_path(return_to: store_course_path(@course)) %></p><% end %>
  <%= form_with model: @user, url: (@invite ? registration_path(invite: params[:invite]) : registration_path(course: @course.slug)), class: "form" do |f| %>
    <%= render "shared/errors", record: @user %>
    <div class="field"><%= f.label :name, "Your name" %><%= f.text_field :name, required: true, autocomplete: "name", autofocus: true %></div>
    <div class="field"><%= f.label :email_address, "Email" %><%= f.email_field :email_address, required: true, autocomplete: "username" %></div>
    <div class="field"><%= f.label :password %><span class="hint">At least 10 characters.</span><%= f.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <div class="field"><%= f.label :password_confirmation, "Repeat password" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <p class="small muted"><%= brand.disclosure %> See the <%= link_to "privacy notice", privacy_path %><% unless @invite %>, the <%= link_to "terms", terms_path %> and the <%= link_to "refund policy", refunds_path %><% end %>.</p>
    <div><%= f.submit "Create account", class: "btn btn-primary" %></div>
  <% end %>
</div>
