<%# The one course list, grouped by program. Used by the Courses page, the classroom's "Switch class" and the welcome screen.
    locals: entries, current_code (the course the student is in class for, if any), prefix (unique per list on a page),
            heading (the level of a program heading here: 2 under a page's h1, 3 under an h2) %>
<% current_code = local_assigns[:current_code]; prefix = local_assigns.fetch(:prefix, "course"); level = local_assigns.fetch(:heading, 2) %>
<% current_program = entries.find { |e| current_code && e.code == current_code }&.program %>
<div class="program-list" data-controller="disclosure">
  <% placed, unplaced = entries.group_by(&:program).partition { |name, _| name != Catalog::OTHER } %><%# catalogue order, unplaced courses last %>
  <% (placed + unplaced).each do |program, list| %>
    <% program_id = "#{prefix}-program-#{program.parameterize}" %>
    <section class="program<%= " is-current" if program == current_program %>" aria-labelledby="<%= program_id %>">
      <div class="program-head">
        <%= content_tag "h#{level}", id: program_id do %><% unless [ "Start here", Catalog::OTHER ].include?(program) %><span class="program-word">Program</span> <% end %><%= program %><% end %>
        <p class="program-meta"><%= list.all?(&:tour?) ? pluralize(list.sum { |e| e.lessons.size }, "tour") : pluralize(list.size, "course") %><% if program == current_program %> · <strong>You are in this program now</strong><% end %></p>
      </div>
      <ul class="course-list">
        <% list.each do |entry| %>
          <% state = entry.state %>
          <li class="course-pick is-<%= state %><%= " is-current" if current_code && entry.code == current_code %>">
            <div class="course-pick-main">
              <p class="eyebrow"><%= [ (entry.code unless entry.tour? || entry.code.blank?), (entry.professor.to_s.match?(/tutor/i) ? "AI tutor" : (entry.professor.present? ? "#{entry.professor} (AI tutor)" : nil)) ].compact.join(" · ") %></p>
              <%= content_tag "h#{level + 1}", class: "course-name" do %><%= link_to entry.title, course_path(entry) %><% end %>
              <% if entry.tagline.present? %><p class="course-tagline"><%= entry.tagline %></p><% end %>
              <p class="meta"><span class="course-state"><%= current_code && entry.code == current_code && state == :new ? entry.status_line.sub("Not started · ", "") : entry.status_line %></span><% if current_code && entry.code == current_code %> · <strong>You are in this class now</strong><% end %></p>
            </div>
            <div class="course-pick-act">
              <%= render "courses/launch", entry: entry, size: "" %>
              <%= link_to course_path(entry), class: "link-button course-more-toggle", role: "button", aria: { expanded: false, controls: "#{prefix}-#{entry.slug}-more" }, data: { action: "disclosure#toggle keydown->disclosure#key" } do %>Details<span class="visually-hidden"> of <%= entry.title %></span><% end %>
            </div>
            <div class="course-more" id="<%= prefix %>-<%= entry.slug %>-more" hidden>
              <dl class="course-facts">
                <% unless entry.program == Catalog::OTHER %><dt>Program</dt><dd><%= entry.program %></dd><% end %>
                <% if entry.level.present? %><dt>Level</dt><dd><%= entry.level %></dd><% end %>
                <% if entry.time.present? %><dt>Time</dt><dd><%= entry.time %></dd><% end %>
                <dt>How it's taught</dt><dd><%= [ ("#{pluralize(entry.lessons.size, entry.tour? ? 'tour' : 'class')} in the classroom, one step at a time" if entry.classroom?), ("#{pluralize(entry.course.lessons.size, 'reading lesson')} with an AI tutor" if entry.course&.lessons&.any?) ].compact.to_sentence.upcase_first %></dd>
              </dl>
              <% if entry.outcomes.any? %>
                <p class="course-more-head">What you'll be able to do</p>
                <ul><% entry.outcomes.each do |outcome| %><li><%= outcome %></li><% end %></ul>
              <% end %>
              <p class="small"><%= link_to "See every class in #{entry.title}", course_path(entry) %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
