<%# The one class list, grouped by program. Used by the classroom's "Switch class" and the welcome screen.
    locals: entries, current_code (the course the student is in class for, if any), prefix (unique per list on a page),
            heading (the level of a program heading here: 2 under a page's h1, 3 under an h2) %>
<% current_code = local_assigns[:current_code]; prefix = local_assigns.fetch(:prefix, "course"); level = local_assigns.fetch(:heading, 2) %>
<% current_program = entries.find { |e| current_code && e.code == current_code }&.program %>
<div class="program-list" data-controller="disclosure">
  <% placed, unplaced = entries.group_by(&:program).partition { |name, _| name != Catalog::OTHER } %><%# catalogue order, unplaced courses last %>
  <% (placed + unplaced).each do |program, list| %>
    <% program_id = "#{prefix}-program-#{program.parameterize}" %>
    <section class="program<%= " is-current" if program == current_program %>" aria-labelledby="<%= program_id %>">
      <div class="program-head">
        <%= content_tag "h#{level}", id: program_id do %><% unless [ Catalog::START, Catalog::OTHER ].include?(program) %><span class="program-word">Program</span> <% end %><%= program %><% end %>
        <p class="program-meta"><%= list.all?(&:tour?) ? pluralize(list.sum { |e| e.lessons.size }, "tour") : pluralize(list.size, "class") %><% if program == current_program %> · <strong>You are in this program now</strong><% end %></p>
      </div>
      <ul class="course-list">
        <% list.each do |entry| %>
          <%= render "courses/pick", entry: entry, current_code: current_code, prefix: prefix, level: level %>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
