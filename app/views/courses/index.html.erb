<% page_title "Courses" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Catalog</p><h1>Courses</h1>
  <p class="lede">Every course at <%= brand.name %>, in one list, grouped by program. Press Details to see what a course covers, or Start to open it in the classroom.</p>
</div></header>
<section class="section"><div class="wrap">
  <% if @entries.any? %>
    <%= render "courses/list", entries: @entries %>
  <% else %>
    <p class="muted">No courses are published yet. The faculty are writing them.</p>
  <% end %>
  <% if Course.published.sold.exists? %><p style="margin-top:24px">Some courses are sold separately. <%= link_to "See the courses for sale", store_path %></p><% end %>
  <p class="muted small" style="margin-top:24px">Finishing a course earns a certificate of completion. It records what you did. It is not academic credit or a degree.</p>
</div></section>
