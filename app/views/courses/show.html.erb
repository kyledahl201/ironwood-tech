<% page_title @entry.title %>
<% content_for :description, @entry.tagline %>
<header class="page-head"><div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><%= link_to "Courses", courses_path %></li><li aria-current="page"><%= @entry.title %></li></ol></nav>
  <p class="eyebrow"><%= [ (@entry.program unless @entry.program == Catalog::OTHER), (@entry.code unless @entry.tour? || @entry.code.blank?) ].compact.join(" · ") %></p>
  <h1><%= @entry.title %></h1>
  <p class="lede"><%= @entry.tagline %></p>
</div></header>

<section class="section"><div class="wrap course-layout">
  <div>
    <dl class="facts">
      <% unless @entry.program == Catalog::OTHER %><dt>Program</dt><dd><%= @entry.program %></dd><% end %>
      <% if @entry.level.present? %><dt>Level</dt><dd><%= @entry.level %></dd><% end %>
      <% if @entry.time.present? %><dt>Time</dt><dd><%= @entry.time %></dd><% end %>
      <dt>Tutor</dt><dd><%= @course ? tutor_label(@course).upcase_first : "#{@entry.professor}, an AI tutor" %></dd>
    </dl>

    <% if @entry.outcomes.any? %>
      <h2>What you'll be able to do</h2>
      <ul class="prose"><% @entry.outcomes.each do |o| %><li><%= o %></li><% end %></ul>
    <% end %>

    <% if @entry.owned? && @entry.classroom? %>
      <h2 style="margin-top:40px"><%= @entry.tour? ? "The tours" : "Classes in the classroom" %></h2>
      <ol class="ex-list">
        <% @entry.lessons.each do |lesson| %>
          <% progress = @progress[lesson.id] %>
          <% open = @entry.open.include?(lesson.id) %>
          <% state = progress&.completed? ? "is-passed" : (open ? "is-open" : "is-locked") %>
          <li class="ex-row <%= state %>">
            <span class="ex-state" aria-hidden="true"><%= progress&.completed? ? "✓" : (open ? "›" : "") %></span>
            <div class="ex-body">
              <% label = lesson.tour? ? lesson.title : "Lesson #{lesson.lesson_number}: #{lesson.title}" %>
              <% if open %><%= link_to label, class_lesson_path(lesson), class: "ex-title" %><% else %><span class="ex-title"><%= label %></span><% end %>
              <span class="muted small"><%= [ lesson.professor && "#{lesson.professor} (AI tutor)", lesson.minutes && "about #{lesson.minutes} min", "#{lesson.steps.size} steps" ].compact.join(" · ") %></span>
              <% if open %>
                <span class="lesson-links">
                  <%= link_to "Study guide and flashcards", study_class_lesson_path(lesson) %>
                  <% if (summary = @studied[lesson.id]&.summary).present? %><span class="muted"><%= summary %></span><% end %>
                  <% if progress&.completed? && lesson.homework.any? %>
                    <% done = @handed_in[lesson.id].to_i %>
                    <%= link_to (done >= lesson.homework.size ? "Homework handed in · awaiting review" : "Homework: #{done} of #{lesson.homework.size} handed in"), homework_class_lesson_path(lesson) %>
                  <% end %>
                </span>
              <% end %>
            </div>
            <span class="ex-tag small">
              <% if progress&.completed? %>Finished<% elsif progress && progress.step_index.positive? %>Step <%= progress.step_index + 1 %> of <%= lesson.steps.size %><% elsif open %>Open<% else %>Opens after lesson <%= lesson.lesson_number - 1 %><% end %>
            </span>
          </li>
        <% end %>
      </ol>
      <% if @kit %>
        <details class="kit panel">
          <summary><strong>Tutor kit:</strong> set up <%= @entry.professor %> in your own Claude project</summary>
          <p>You can ask <%= @entry.professor %> a question inside any class. If you would rather have a longer conversation in a Claude project of your own, this kit sets one up. You need a Claude Pro account. The kit is <%= pluralize(@kit.files.size, "small text file") %>: who the professor is, the rules, the syllabus and the rubrics. It holds no answers.</p>
          <ol>
            <li>Download the kit and unzip it.</li>
            <li>In Claude, make a new project. Paste <code>PROJECT-INSTRUCTIONS.md</code> into the project's instructions, and add the other files to the project.</li>
            <li>In class, press <strong>Copy for my tutor</strong> in the workbench, then paste it into a chat in that project and ask your question.</li>
          </ol>
          <p><%= link_to "Download the tutor kit", tutor_kit_path(@kit.slug), class: "btn btn-copper", data: { turbo: false } %> <span class="small muted">README.md inside has the full steps.</span></p>
          <p class="small">Or one file at a time, for when a new week's notes are added: <% @kit.names.each do |name| %><%= link_to name, tutor_kit_file_path(@kit.slug, name), data: { turbo: false } %><%= " · " unless name == @kit.names.last %><% end %></p>
          <p class="small muted">The professor in your Claude project is an AI tutor persona. It can't see the portal, so it only knows what you paste. The portal's checks stay the record of your work.</p>
        </details>
      <% end %>
    <% end %>

    <% if @course&.description.present? %><div class="prose" style="margin-top:40px"><%= markdown @course.description %></div><% end %>

    <% if @entry.owned? && @lessons.any? %>
      <h2 style="margin-top:40px"><%= @entry.classroom? ? "Reading for each week" : (@lessons.size > 10 ? "The #{@lessons.size} weeks" : "Lessons") %></h2>
      <% if @entry.classroom? %>
        <p class="muted">The written notes for each week, with the tutor beside them.</p>
      <% end %>
      <ol class="syllabus">
        <% @lessons.each do |lesson| %>
          <li>
            <span class="pos"><%= lesson.position %></span>
            <%= link_to lesson.title, learn_lesson_path(@course, lesson) %>
            <% if @enrollment&.completed?(lesson) %><span class="done">Done</span><% end %>
          </li>
        <% end %>
      </ol>
      <p style="margin-top:16px"><%= link_to "Read the rubric your work is reviewed against", rubric_course_path(@course) %></p>
    <% end %>
  </div>

  <aside class="buy-box" aria-label="Start">
    <% if !@entry.owned? %>
      <p><strong>You don't have this course yet.</strong></p>
      <% if @entry.access_course&.on_sale? %>
        <p>It's in the store. Once it's yours, it opens right here.</p>
      <% else %>
        <p>Courses here open once you own them. The owner gives this one, so ask for access.</p>
      <% end %>
    <% elsif @entry.classroom? %>
      <p><strong><%= @entry.status_line %></strong></p>
      <p><%= @entry.tour? ? "#{@entry.next_lesson.title}." : "Lesson #{@entry.next_lesson.lesson_number}: #{@entry.next_lesson.title}." %> It opens in the classroom.</p>
    <% elsif @lessons.any? %>
      <p><strong><%= @entry.status_line %></strong></p>
      <p>Self-paced, with an AI tutor.</p>
    <% else %>
      <p><strong><%= @entry.status_line %></strong></p>
      <p>Lessons are still being written.</p>
    <% end %>
    <%= render "courses/launch", entry: @entry, size: "" %>
    <p class="small muted" style="margin-top:12px"><%= brand.disclosure %></p>
  </aside>
</div></section>
