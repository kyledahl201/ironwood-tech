<% page_title @exercise.title %>
<div class="lab" data-controller="lab"
     data-lab-slug-value="<%= @exercise.slug %>"
     data-lab-checks-value="<%= @exercise.checks.to_json %>"
     data-lab-hints-value="<%= Array(@exercise.hints).to_json %>"
     data-lab-starter-value="<%= @exercise.starter_code %>"
     data-lab-worker-url-value="/lab/ruby-worker.js"
     data-lab-wasm-url-value="<%= brand.ruby_wasm_url %>"
     data-lab-attempts-url-value="<%= exercise_attempts_path(@exercise) %>"
     data-lab-log-url-value="<%= portal_study_sessions_path %>"
     data-lab-course-value="<%= @exercise.course_code %>"
     data-lab-passed-value="<%= @exercise.passed_by?(current_user) %>"
     data-lab-pass-lines-value="<%= SentryLines::PASS.to_json %>"
     data-lab-first-try-lines-value="<%= SentryLines::PASS_FIRST_TRY.to_json %>"
     data-lab-fail-lines-value="<%= SentryLines::FAIL.to_json %>">
  <section class="lab-brief">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><%= link_to "Code lab", exercises_path %></li><li><%= @exercise.course_code %></li></ol></nav>
    <p class="eyebrow"><%= @exercise.lesson_label.presence || "Lesson #{@exercise.lesson_number}" %></p>
    <h1><%= @exercise.title %></h1>
    <div class="prose lab-prompt"><%= markdown @exercise.prompt %></div>

    <h2 class="lab-sub">Checks</h2>
    <ul class="chips" data-lab-target="chips">
      <% @exercise.checks.each_with_index do |c, i| %>
        <li class="chip" data-index="<%= i %>"><span class="chip-dot" aria-hidden="true"></span><span class="chip-label"><%= c["label"] %></span><span class="chip-word"></span></li>
      <% end %>
    </ul>

    <p class="small muted">Checks run in your browser, so a pass here is self-checked. Graded work goes through your professor.</p>

    <div class="hints" data-lab-target="hints" hidden>
      <h2 class="lab-sub">Hints</h2>
      <ol data-lab-target="hintList"></ol>
      <button type="button" class="link-button" data-lab-target="hintButton" data-action="lab#nextHint">Show a hint</button>
    </div>

    <% if @exercise.weak_spot.present? && @exercise.weak_spot != "none" %>
      <p class="small muted">Practises: <%= @exercise.weak_spot %></p>
    <% end %>
    <% if @list.size > 1 %>
      <nav class="lab-siblings" aria-label="<%= @exercise.course_code %> exercises">
        <% @list.each do |e| %>
          <% if e.unlocked_for?(current_user) %><%= link_to e.title, exercise_path(e), class: ("is-current" if e == @exercise), "aria-current": (e == @exercise ? "page" : nil) %><% end %>
        <% end %>
      </nav>
    <% end %>
  </section>

  <section class="lab-bench" aria-label="Editor">
    <div class="bench-bar">
      <span class="bench-file">main.rb</span>
      <span class="bench-status" data-lab-target="status" role="status">Loading Ruby…</span>
      <span class="bench-timer" data-lab-target="timer" title="Time on this exercise">0:00</span>
    </div>
    <div class="editor-host" data-lab-target="editor"><textarea class="editor-fallback" aria-label="Code editor" spellcheck="false"><%= @exercise.starter_code %></textarea></div>
    <div class="bench-actions">
      <button type="button" class="btn btn-outline-light" data-action="lab#run" data-lab-target="runButton" title="Shift+Enter">Run</button>
      <button type="button" class="btn btn-copper" data-action="lab#check" data-lab-target="checkButton" title="Ctrl/Cmd+Enter">Check</button>
      <button type="button" class="link-button light small" data-action="lab#reset">Reset to starter</button>
      <button type="button" class="link-button light small" data-action="lab#logTime" data-lab-target="logButton" hidden>Log time</button>
    </div>
    <div class="console" aria-label="Output">
      <div class="console-head">Output</div>
      <pre class="console-body" data-lab-target="output" aria-live="polite">Press Run to see what your code prints.</pre>
      <div class="diff" data-lab-target="diff" hidden></div>
    </div>
    <div class="lab-next" data-lab-target="next" hidden></div>
  </section>
</div>
