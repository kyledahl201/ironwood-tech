<% page_title "Leads" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Owner</p><h1>Leads</h1>
<p><%= link_to "All", admin_leads_path %> · <%= link_to "Consulting", admin_leads_path(kind: "consulting") %> · <%= link_to "Newsletter", admin_leads_path(kind: "newsletter") %></p></div></header>
<section class="section"><div class="wrap"><div class="table-scroll"><table>
  <thead><tr><th>When</th><th>Kind</th><th>Name</th><th>Email</th><th>Organization</th><th>Message</th><th>Status</th></tr></thead>
  <tbody>
    <% @leads.each do |l| %>
      <tr>
        <td><%= l.created_at.to_fs(:short) %></td><td><%= l.kind %></td><td><%= l.name %></td><td><%= mail_to l.email %><% if l.kind == "newsletter" %><br><%= link_to "unsubscribe link", unsubscribe_url(l.unsubscribe_token), class: "small" %><% end %></td>
        <td><%= [l.company, l.job_title].compact_blank.join(" · ") %></td><td><%= simple_format l.message %></td>
        <td><%= form_with model: [:admin, l], method: :patch do |f| %><%= f.select :status, Lead::STATUSES, {}, onchange: "this.form.requestSubmit()", "aria-label": "Status" %><% end %></td>
      </tr>
    <% end %>
  </tbody>
</table></div></div></section>
