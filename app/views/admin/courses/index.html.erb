<% page_title "Courses" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Owner</p><h1>Courses</h1></div></header>
<section class="section"><div class="wrap"><div class="table-scroll"><table>
  <thead><tr><th>Course</th><th>Price</th><th>Published</th><th>Lessons</th><th>Students</th><th></th></tr></thead>
  <tbody><% @courses.each do |c| %>
    <tr><td><%= link_to c.title, course_path(c) %></td><td><%= c.price %></td><td><%= c.published ? "Yes" : "No" %></td><td><%= c.lessons.size %></td><td><%= c.enrollments.size %></td><td><%= link_to "Edit", edit_admin_course_path(c) %></td></tr>
  <% end %></tbody>
</table></div></div></section>
