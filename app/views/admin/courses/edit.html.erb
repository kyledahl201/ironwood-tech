<% page_title "Edit #{@course.title}" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Owner</p><h1>Edit <%= @course.title %></h1></div></header>
<section class="section"><div class="wrap">
  <%= form_with model: [:admin, @course], class: "form" do |f| %>
    <%= render "shared/errors", record: @course %>
    <div class="field"><%= f.label :title %><%= f.text_field :title %></div>
    <div class="field"><%= f.label :tagline %><%= f.text_field :tagline %></div>
    <div class="field"><%= f.label :level %><%= f.text_field :level %></div>
    <div class="field"><%= f.label :tutor_name %><%= f.text_field :tutor_name %></div>
    <div class="field"><%= f.label :tutor_bio, "Tutor persona (sent to the AI)" %><%= f.text_area :tutor_bio, rows: 4 %></div>
    <div class="field"><%= f.label :description, "Description (Markdown)" %><%= f.text_area :description, rows: 12 %></div>
    <% if @course.paid? %>
      <div class="field">
        <%= f.label :price_cents, "Price in cents (US dollars)" %>
        <span class="hint" id="price-hint">2900 means $29.00. Leave it empty and the course can't be bought. The smallest price is 50.</span>
        <%= f.number_field :price_cents, min: 50, step: 1, inputmode: "numeric", aria: { describedby: "price-hint" } %>
      </div>
      <p class="small" role="status">This is a sold course. It is <strong><%= @course.on_sale? ? "on sale for #{@course.price}" : "not on sale" %></strong><%= " (it needs #{[ ("a price" unless @course.price_cents), ("to be published" unless @course.published?) ].compact.to_sentence})" unless @course.on_sale? %>. Checkout is <%= Payments.status_line %>. <%= link_to "See its store page", store_course_path(@course) %></p>
    <% else %>
      <p class="small muted">This course is free to every student in the portal. It has no price.</p>
    <% end %>
    <label class="checkbox"><%= f.check_box :published %> Published</label>
    <div><%= f.submit "Save", class: "btn btn-primary" %></div>
  <% end %>
</div></section>
