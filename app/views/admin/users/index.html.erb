<% page_title "Students" %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Owner</p><h1>Students</h1></div></header>
<section class="section"><div class="wrap"><div class="table-scroll"><table>
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Courses</th></tr></thead>
  <tbody><% @users.each do |u| %>
    <tr><td><%= link_to u.name, admin_user_path(u) %></td><td><%= u.email_address %></td><td><%= u.role %></td><td><%= u.created_at.to_date.to_fs(:short) %></td><td><%= u.enrollments.map { |e| e.course.title }.join(", ") %></td></tr>
  <% end %></tbody>
</table></div></div></section>
