<% page_title @user.name %>
<header class="page-head"><div class="wrap"><p class="eyebrow">Student</p><h1><%= @user.name %></h1><p><%= @user.email_address %> · joined <%= @user.created_at.to_date.to_fs(:long) %></p></div></header>
<section class="section"><div class="wrap">
  <h2>Courses <%= @user.first_name %> owns</h2>
  <div class="table-scroll"><%= render "admin/enrollments/table", enrollments: @user.enrollments.includes(:course, :user), show_student: false %></div>
  <h2 style="margin-top:32px">Give a course</h2>
  <p class="muted small">Gives <%= @user.first_name %> a course right away, without payment and without an email. Every course must be owned to open, including the classroom courses. To send a claim link by email instead, use <%= link_to "Gifts", admin_gifts_path %>.</p>
  <%= form_with url: admin_enrollments_path, class: "inline-form" do |f| %>
    <%= f.hidden_field :user_id, value: @user.id %>
    <%= f.label :course_id, "Course", class: "visually-hidden" %>
    <%= f.select :course_id, @courses.map { |c| [ [ c.title, c.code ].compact.uniq.join(" · "), c.id ] } %>
    <%= f.submit "Give course", class: "btn btn-primary" %>
  <% end %>
  <% unless @user.admin? %>
    <h2 style="margin-top:32px">Portal access</h2>
    <% if @user.customer_only? %>
      <p>This account was made by buying a course. It sees the store, the courses it owns and its account page, not Today, the study log or the study hall.</p>
      <%= button_to "Open the whole portal to #{@user.first_name}", admin_user_path(@user), method: :patch, params: { user: { customer_only: "0" } }, class: "btn btn-outline" %>
    <% else %>
      <p>This account has the whole portal, like every invited student.</p>
      <%= button_to "Limit #{@user.first_name} to the store and purchases", admin_user_path(@user), method: :patch, params: { user: { customer_only: "1" } }, class: "link-button small" %>
    <% end %>
  <% end %>
</div></section>
