<%# locals: enrollments, show_student %>
<table>
  <thead><tr><% if show_student %><th>Student</th><% end %><th>Course</th><th>How</th><th>Paid</th><th>Since</th><th>Access</th><th></th></tr></thead>
  <tbody>
    <% enrollments.each do |e| %>
      <tr>
        <% if show_student %><td><%= link_to e.user.name, admin_user_path(e.user) %><br><span class="small muted"><%= e.user.email_address %></span></td><% end %>
        <td><%= e.course.title %></td>
        <td><%= { "self" => "Started it (free)", "admin" => "Added by owner", "stripe" => "Bought (Stripe)" }[e.source] %></td>
        <td><%= e.amount_cents ? number_to_currency(e.amount_cents / 100.0) : "—" %></td>
        <td><%= e.created_at.to_date.to_fs(:short) %></td>
        <td><%= e.active? ? "Active" : "Ended #{e.revoked_at.to_date.to_fs(:short)} (#{e.revoke_reason})" %></td>
        <td>
          <% if e.active? %>
            <%= button_to "End access", revoke_admin_enrollment_path(e), class: "link-button small", form: { data: { turbo_confirm: "End #{e.user.name}'s access to #{e.course.title}? This does not refund any payment." } } %>
          <% else %>
            <%= button_to "Give back", reinstate_admin_enrollment_path(e), class: "link-button small" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
